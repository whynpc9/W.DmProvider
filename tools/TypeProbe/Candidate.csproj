<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TypeProbe.Candidate</AssemblyName><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);CANDIDATE</DefineConstants>
    <OutputPath>bin/Candidate/</OutputPath><BaseIntermediateOutputPath>obj/Candidate/</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /><ProjectReference Include="../../src/W.DmProvider/W.DmProvider.csproj" /></ItemGroup>
</Project>
