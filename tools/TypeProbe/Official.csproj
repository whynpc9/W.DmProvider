<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TypeProbe.Official</AssemblyName><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);OFFICIAL</DefineConstants>
    <OutputPath>bin/Official/</OutputPath><BaseIntermediateOutputPath>obj/Official/</BaseIntermediateOutputPath>
    <RestoreSources>$(MSBuildThisFileDirectory)../../packages</RestoreSources>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /><PackageReference Include="DM.DmProvider" Version="8.3.1.47463" /></ItemGroup>
</Project>
