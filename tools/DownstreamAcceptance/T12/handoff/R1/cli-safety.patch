+    private static void AssertGeneratedSourcesContainNoSecret(string projectDirectory, string connectionString)
+    {
+        var forbidden = new List<string> { connectionString };
+        var builder = new DbConnectionStringBuilder { ConnectionString = connectionString };
+        foreach (string key in builder.Keys)
+            if (key.Contains("password", StringComparison.OrdinalIgnoreCase) || key.Equals("pwd", StringComparison.OrdinalIgnoreCase))
+            {
+                string? value = Convert.ToString(builder[key], CultureInfo.InvariantCulture);
+                if (!string.IsNullOrEmpty(value)) forbidden.Add(value);
+            }
+        foreach (string file in Directory.EnumerateFiles(projectDirectory, "*", SearchOption.AllDirectories))
+        {
+            if (Path.GetExtension(file) is not (".cs" or ".json" or ".sql" or ".xml")) continue;
+            string content = File.ReadAllText(file);
+            Assert.True(!forbidden.Any(value => content.Contains(value, StringComparison.Ordinal)),
+                "CLI generated text must not contain a connection or password literal.");
+        }
+    }
