+    private static async Task CleanupOwnedObjectsAsync(string connectionString, string tableName, string historyName, string sequenceName)
+    {
+        var objects = new[]
+        {
+            (View: "USER_TABLES", Column: "TABLE_NAME", Name: tableName),
+            (View: "USER_TABLES", Column: "TABLE_NAME", Name: historyName),
+            (View: "USER_SEQUENCES", Column: "SEQUENCE_NAME", Name: sequenceName)
+        };
+        var failures = new List<string>();
+        foreach (var owned in objects)
+        {
+            try
+            {
+                await using var connection = new DmConnection(connectionString);
+                await connection.OpenAsync();
+                await VerifyIdentityAsync(connection);
+                await DropIfExistsAsync(connection, owned.View, owned.Column, owned.Name);
+            }
+            catch (Exception error) { failures.Add(error.GetType().FullName ?? "unknown"); }
+        }
+        // A failed command must not prevent attempts to remove the other owned objects.
+        await using var finalConnection = new DmConnection(connectionString);
+        await finalConnection.OpenAsync();
+        await VerifyIdentityAsync(finalConnection);
+        foreach (var owned in objects)
+            await AssertAbsentAsync(finalConnection, owned.View, owned.Column, owned.Name);
+        if (failures.Count > 0)
+            throw new InvalidOperationException("CLI cleanup failed; exception_kinds=" + string.Join(",", failures));
+    }
