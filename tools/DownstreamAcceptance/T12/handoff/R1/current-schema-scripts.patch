+using System.Data.Common;
+using System.Globalization;
+using Dm;
+using Microsoft.EntityFrameworkCore;
+using Microsoft.EntityFrameworkCore.Infrastructure;
+using Microsoft.EntityFrameworkCore.Metadata;
+using Microsoft.EntityFrameworkCore.Migrations;
+using Microsoft.EntityFrameworkCore.Migrations.Operations;
+using Xunit;
+using Xunit.Abstractions;
+
+namespace W.EntityFrameworkCore.Dameng.FunctionalTests;
+
+// Same object/seed contracts as the original script tests, with current-schema
+// objects and reversible migrations. The original admin fixture remains untouched.
+[Collection(DamengCurrentSchemaScriptSet.Name)]
+[Trait("Category", "CurrentSchemaScripts")]
+public sealed class DamengCurrentSchemaScriptFunctionalTests(
+    DamengCurrentSchemaScriptDatabase database, ITestOutputHelper output)
+{
+    private const string CreateMigration = "20260930000100_CurrentSchemaCreate";
+    private const string AlterMigration = "20260930000200_CurrentSchemaAlter";
+    private readonly DamengCurrentSchemaScriptDatabase _database = database;
+
+    [Fact]
+    public async Task GeneratedCreateScriptAppliesSupportedCurrentSchemaModel()
+    {
+        var names = CurrentSchemaScriptObjectNames.ForPrefix(NewPrefix());
+        await WithOwnedAsync(names, async connection =>
+        {
+            var options = new DbContextOptionsBuilder<CurrentSchemaScriptBootstrapContext>()
+                .UseDameng(_database.ConnectionString)
+                .ReplaceService<IModelCacheKeyFactory, CurrentSchemaScriptBootstrapCacheKeyFactory>().Options;
+            await using var context = new CurrentSchemaScriptBootstrapContext(options, names);
+            var script = context.Database.GenerateCreateScript();
+            AssertScriptBoundaries(script, idempotent: false);
+            Assert.Contains("IDENTITY(10,2)", script, StringComparison.Ordinal);
+            Assert.Contains("NEXTVAL", script, StringComparison.Ordinal);
+            Assert.Contains("UPPER(\"NAME\")", script, StringComparison.Ordinal);
+            Assert.Contains("ON DELETE CASCADE", script, StringComparison.Ordinal);
+            Assert.Contains("DESC", script, StringComparison.Ordinal);
+            Assert.Contains("SET IDENTITY_INSERT", script, StringComparison.Ordinal);
+            await ExecuteScriptAsync(connection, script, idempotent: false);
+
+            await using var check = await _database.OpenAsync();
+            var seeded = await ReadParentAsync(check, names.ParentTable, "NOTE", 20);
+            Assert.Equal("种子", seeded.Name);
+            Assert.Equal("O'Brien", seeded.Extra);
+            Assert.Equal(22L, await InsertParentAsync(check, names.ParentTable, "新行"));
+            Assert.Equal(41L, await InsertChildAsync(check, names.ChildTable, 20));
+            Assert.Equal("DAMENG", await ScalarStringAsync(check,
+                "SELECT \"NORMALIZED_NAME\" FROM \"" + names.ChildTable + "\" WHERE \"ID\" = 41"));
+            Assert.Equal(new byte[] { 0, 0xA5, 0xFF }, await ScalarBytesAsync(check,
+                "SELECT \"PAYLOAD\" FROM \"" + names.ChildTable + "\" WHERE \"ID\" = 41"));
+            await AssertIndexAsync(check, names.Index, "ID");
+            foreach (var constraint in new[] { names.PrimaryKey, names.UniqueConstraint, names.CheckConstraint, names.ForeignKey })
+                await AssertConstraintAsync(check, constraint);
+            Assert.Equal(44L, await ScalarInt64Async(check, "SELECT \"" + names.Sequence + "\".NEXTVAL FROM DUAL"));
+            Assert.Equal(0L, await ScalarInt64Async(check,
+                "SELECT COUNT(*) FROM USER_TABLES WHERE TABLE_NAME = :name", ("name", names.HistoryTable)));
+            await ExecuteAsync(check, "DELETE FROM \"" + names.ParentTable + "\" WHERE \"ID\" = 20");
+            Assert.Equal(0L, await ScalarInt64Async(check, "SELECT COUNT(*) FROM \"" + names.ChildTable + "\""));
+            Assert.Equal(1L, await ScalarInt64Async(check, "SELECT COUNT(*) FROM \"" + names.ParentTable + "\" WHERE \"ID\" = 22"));
+        });
+    }
+
+    [Fact]
+    public async Task NonIdempotentGeneratedUpAndDownScriptsPreserveHistoryAndSeed()
+    {
+        var names = CurrentSchemaScriptObjectNames.ForMigrationPrefix(NewPrefix());
+        await WithOwnedAsync(names, async connection =>
+        {
+            CurrentSchemaScriptNames.Prefix = names.Prefix;
+            var up = Generate(names, Migration.InitialDatabase, null, idempotent: false);
+            AssertMigrationScript(up, names);
+            Assert.Contains("ALTER TABLE", up, StringComparison.Ordinal);
+            Assert.Contains("RENAME", up, StringComparison.Ordinal);
+            Assert.Contains("INCREMENT BY 5", up, StringComparison.Ordinal);
+            await ExecuteScriptAsync(connection, up, idempotent: false);
+            await using (var check = await _database.OpenAsync())
+            {
+                await AssertUpgradedModelAsync(check, names);
+                await AssertHistoryRowsAsync(check, names, CreateMigration, AlterMigration);
+                Assert.Equal(43L, await InsertChildAsync(check, names.ChildTable, 22));
+                Assert.Equal(48L, await ScalarInt64Async(check, "SELECT \"" + names.Sequence + "\".NEXTVAL FROM DUAL"));
+            }
+            var down = Generate(names, AlterMigration, Migration.InitialDatabase, idempotent: false);
+            await ExecuteScriptAsync(connection, down, idempotent: false);
+            await AssertRevertedAsync(names);
+        });
+    }
+
+    [Fact]
+    public async Task IdempotentGeneratedUpAndDownScriptsApplyExactlyOnce()
+    {
+        var names = CurrentSchemaScriptObjectNames.ForMigrationPrefix(NewPrefix());
+        await WithOwnedAsync(names, async connection =>
+        {
+            CurrentSchemaScriptNames.Prefix = names.Prefix;
+            var up = Generate(names, Migration.InitialDatabase, null, idempotent: true);
+            Assert.Contains("EXECUTE IMMEDIATE", up, StringComparison.Ordinal);
+            Assert.Contains("IF NOT EXISTS", up, StringComparison.Ordinal);
+            await ExecuteScriptAsync(connection, up, idempotent: true);
+            await ExecuteScriptAsync(connection, up, idempotent: true);
+            await using (var check = await _database.OpenAsync())
+            {
+                Assert.Equal(1L, await ScalarInt64Async(check,
+                    "SELECT COUNT(*) FROM \"" + names.ParentTable + "\" WHERE \"ID\" = 20"));
+                Assert.Equal(1L, await ScalarInt64Async(check, "SELECT COUNT(*) FROM \"" + names.ParentTable + "\""));
+                Assert.Equal(1L, await CountHistoryAsync(check, names.HistoryTable, CreateMigration));
+                Assert.Equal(1L, await CountHistoryAsync(check, names.HistoryTable, AlterMigration));
+                await AssertHistoryRowsAsync(check, names, CreateMigration, AlterMigration);
+            }
+            var down = Generate(names, AlterMigration, Migration.InitialDatabase, idempotent: true);
+            Assert.Contains("BEGIN", down, StringComparison.Ordinal);
+            await ExecuteScriptAsync(connection, down, idempotent: true);
+            await ExecuteScriptAsync(connection, down, idempotent: true);
+            await AssertRevertedAsync(names);
+        });
+    }
+
+    [Fact]
+    public async Task GeneratedMigrationRangesUpgradeAndDowngradeCurrentSchema()
+    {
+        var names = CurrentSchemaScriptObjectNames.ForMigrationPrefix(NewPrefix());
+        await WithOwnedAsync(names, async connection =>
+        {
+            CurrentSchemaScriptNames.Prefix = names.Prefix;
+            await ExecuteScriptAsync(connection, Generate(names, Migration.InitialDatabase, CreateMigration, false), false);
+            await using (var first = await _database.OpenAsync())
+            {
+                var seeded = await ReadParentAsync(first, names.ParentTable, "NOTE", 20);
+                Assert.Equal("种子", seeded.Name);
+                Assert.Equal("O'Brien", seeded.Extra);
+                Assert.Equal(1L, await CountHistoryAsync(first, names.HistoryTable, CreateMigration));
+                Assert.Equal(0L, await CountHistoryAsync(first, names.HistoryTable, AlterMigration));
+                await AssertHistoryRowsAsync(first, names, CreateMigration);
+            }
+            await ExecuteScriptAsync(connection, Generate(names, CreateMigration, AlterMigration, false), false);
+            await using (var upgraded = await _database.OpenAsync())
+            {
+                await AssertUpgradedModelAsync(upgraded, names);
+                await AssertHistoryRowsAsync(upgraded, names, CreateMigration, AlterMigration);
+            }
+            await ExecuteScriptAsync(connection, Generate(names, AlterMigration, CreateMigration, false), false);
+            await using (var prior = await _database.OpenAsync())
+            {
+                var seeded = await ReadParentAsync(prior, names.ParentTable, "NOTE", 20);
+                Assert.Equal("O'Brien", seeded.Extra);
+                Assert.Equal(0L, await CountColumnAsync(prior, names.ParentTable, "STATUS"));
+                Assert.Equal(0L, await CountColumnAsync(prior, names.ParentTable, "DISPLAY_NOTE"));
+                Assert.Equal(1L, await CountColumnAsync(prior, names.LookupTable, "LABEL"));
+                Assert.Equal(1L, await CountHistoryAsync(prior, names.HistoryTable, CreateMigration));
+                Assert.Equal(0L, await CountHistoryAsync(prior, names.HistoryTable, AlterMigration));
+                await AssertHistoryRowsAsync(prior, names, CreateMigration);
+                await AssertIndexAsync(prior, names.Index, "ID");
+            }
+            await ExecuteScriptAsync(connection, Generate(names, CreateMigration, Migration.InitialDatabase, false), false);
+            await AssertRevertedAsync(names);
+        });
+    }
+
+    private string Generate(CurrentSchemaScriptObjectNames names, string from, string? to, bool idempotent)
+    {
+        using var context = new DamengCurrentSchemaScriptMigrationContext(
+            new DbContextOptionsBuilder<DamengCurrentSchemaScriptMigrationContext>()
+                .UseDameng(_database.ConnectionString, dm => dm.MigrationsHistoryTable(names.HistoryTable)).Options);
+        return context.GetService<IMigrator>().GenerateScript(fromMigration: from, toMigration: to,
+            options: idempotent ? MigrationsSqlGenerationOptions.Idempotent : MigrationsSqlGenerationOptions.Default);
+    }
+
+    private static async Task ExecuteScriptAsync(DmConnection connection, string script, bool idempotent)
+    {
+        AssertScriptBoundaries(script, idempotent);
+        await DamengScriptExecutor.ExecuteAsync(connection, script, idempotent, DamengCurrentSchemaScriptDatabase.Redact);
+    }
+
+    private static void AssertScriptBoundaries(string script, bool idempotent)
+    {
+        Assert.DoesNotContain("CREATE SCHEMA", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("DROP SCHEMA", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("CREATE USER", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("TABLESPACE", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("BEGIN TRANSACTION", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("@", script, StringComparison.Ordinal);
+        var batches = idempotent ? DamengScriptExecutor.SplitIdempotent(script) : DamengScriptExecutor.SplitStatements(script);
+        Assert.NotEmpty(batches);
+        Assert.All(batches, batch => Assert.DoesNotContain(batch.Split('\n'), line => line.Trim() == "/"));
+        foreach (var block in batches.Where(batch => batch.StartsWith("BEGIN", StringComparison.Ordinal)))
+            Assert.EndsWith("END;", block, StringComparison.Ordinal);
+        if (idempotent) Assert.Contains(batches, batch => batch.StartsWith("BEGIN", StringComparison.Ordinal));
+    }
+
+    private static async Task AssertHistoryRowsAsync(DmConnection connection,
+        CurrentSchemaScriptObjectNames names, params string[] migrationIds)
+    {
+        Assert.Equal((long)migrationIds.Length, await ScalarInt64Async(connection,
+            "SELECT COUNT(*) FROM \"" + names.HistoryTable + "\""));
+        Assert.Equal((long)migrationIds.Length, await ScalarInt64Async(connection,
+            "SELECT COUNT(*) FROM \"" + names.HistoryTable + "\" WHERE \"ProductVersion\" = :version",
+            ("version", "10.0.12")));
+        foreach (var migrationId in migrationIds)
+            Assert.Equal(1L, await CountHistoryAsync(connection, names.HistoryTable, migrationId));
+    }
+
+    private async Task AssertRevertedAsync(CurrentSchemaScriptObjectNames names)
+    {
+        await using var check = await _database.OpenAsync();
+        foreach (var table in DamengCurrentSchemaScriptDatabase.Tables(names).Where(table => table != names.HistoryTable))
+            Assert.Equal(0L, await ScalarInt64Async(check,
+                "SELECT COUNT(*) FROM USER_TABLES WHERE TABLE_NAME = :name", ("name", table)));
+        Assert.Equal(0L, await ScalarInt64Async(check,
+            "SELECT COUNT(*) FROM USER_SEQUENCES WHERE SEQUENCE_NAME = :name", ("name", names.Sequence)));
+        Assert.Equal(0L, await ScalarInt64Async(check, "SELECT COUNT(*) FROM \"" + names.HistoryTable + "\""));
+    }
+
+    private async Task WithOwnedAsync(CurrentSchemaScriptObjectNames names, Func<DmConnection, Task> contract)
+    {
+        await _database.ClaimAsync(names);
+        output.WriteLine("owned_objects=" + string.Join(",", DamengCurrentSchemaScriptDatabase.AllNames(names)));
+        try
+        {
+            await using var connection = await _database.OpenAsync();
+            await contract(connection);
+        }
+        catch (Exception exception) { throw DamengCurrentSchemaScriptDatabase.SafeFailure("contract", exception); }
+        finally
+        {
+            await _database.CleanupAsync(names);
+            output.WriteLine("final_database_state=owned_objects_absent; verified_on_fresh_connection=true");
+        }
+    }
+
+    private static void AssertMigrationScript(string script, CurrentSchemaScriptObjectNames names)
+    {
+        Assert.Contains("IDENTITY(10,2)", script, StringComparison.Ordinal);
+        Assert.Contains(names.Sequence + "\".NEXTVAL", script, StringComparison.Ordinal);
+        Assert.Contains("UPPER(\"NAME\")", script, StringComparison.Ordinal);
+        Assert.Contains("ON DELETE CASCADE", script, StringComparison.Ordinal);
+        Assert.Contains("DESC", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("CREATE SCHEMA", script, StringComparison.Ordinal);
+        Assert.Contains("SET IDENTITY_INSERT", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("@", script, StringComparison.Ordinal);
+    }
+
+    private static async Task AssertUpgradedModelAsync(DmConnection connection, CurrentSchemaScriptObjectNames names)
+    {
+        var seeded = await ReadParentAsync(connection, names.ParentTable, "DISPLAY_NOTE", 20);
+        Assert.Equal("种子", seeded.Name);
+        Assert.Equal("O'Brien", seeded.Extra);
+        Assert.Equal(1, await ScalarInt32Async(
+            connection,
+            "SELECT \"STATUS\" FROM \"" + names.ParentTable + "\" WHERE \"ID\" = :id",
+            ("id", 20L)));
+
+        Assert.Equal(22L, await InsertParentAsync(connection, names.ParentTable, "新行", includeStatus: true));
+        Assert.Equal(1L, await CountHistoryAsync(connection, names.HistoryTable, "20260930000100_CurrentSchemaCreate"));
+        Assert.Equal(1L, await CountHistoryAsync(connection, names.HistoryTable, "20260930000200_CurrentSchemaAlter"));
+        Assert.Equal(0L, await ScalarInt64Async(
+            connection,
+            "SELECT COUNT(*) FROM USER_INDEXES WHERE INDEX_NAME = :name",
+            ("name", names.Index)));
+        await AssertIndexAsync(connection, names.RenamedIndex, descendingColumn: null);
+        Assert.Equal(0L, await ScalarInt64Async(
+            connection,
+            "SELECT COUNT(*) FROM \"" + names.Schema + "\".\"" + names.RenamedLookupTable + "\""));
+        Assert.Equal(0L, await CountColumnAsync(connection, names.RenamedLookupTable, "LABEL"));
+    }
+
+    private static async Task AssertIndexAsync(
+        DmConnection connection,
+        string indexName,
+        string? descendingColumn)
+    {
+        Assert.Equal(1L, await ScalarInt64Async(
+            connection,
+            "SELECT COUNT(*) FROM USER_INDEXES WHERE INDEX_NAME = :name",
+            ("name", indexName)));
+
+        if (descendingColumn is null
+            || await ScalarInt64Async(
+                connection,
+                "SELECT COUNT(*) FROM ALL_TAB_COLUMNS WHERE TABLE_NAME = 'USER_IND_COLUMNS' AND COLUMN_NAME = 'DESCEND'")
+            == 0)
+        {
+            return;
+        }
+
+        Assert.Equal(1L, await ScalarInt64Async(
+            connection,
+            "SELECT COUNT(*) FROM USER_IND_COLUMNS WHERE INDEX_NAME = :name AND COLUMN_NAME = :column "
+            + "AND UPPER(DESCEND) IN ('DESC', 'Y', 'YES')",
+            ("name", indexName),
+            ("column", descendingColumn)));
+    }
+
+    private static async Task AssertConstraintAsync(DmConnection connection, string constraintName)
+        => Assert.Equal(
+            1L,
+            await ScalarInt64Async(
+                connection,
+                "SELECT COUNT(*) FROM USER_CONSTRAINTS WHERE CONSTRAINT_NAME = :name",
+                ("name", constraintName)));
+
+    private static async Task<long> CountColumnAsync(
+        DmConnection connection,
+        string tableName,
+        string columnName)
+        => await ScalarInt64Async(
+            connection,
+            "SELECT COUNT(*) FROM USER_TAB_COLUMNS WHERE TABLE_NAME = :table_name AND COLUMN_NAME = :column_name",
+            ("table_name", tableName),
+            ("column_name", columnName));
+
+    private static async Task<long> CountHistoryAsync(
+        DmConnection connection,
+        string historyTable,
+        string migrationId)
+        => await ScalarInt64Async(
+            connection,
+            "SELECT COUNT(*) FROM \"" + historyTable + "\" WHERE \"MigrationId\" = :id",
+            ("id", migrationId));
+
