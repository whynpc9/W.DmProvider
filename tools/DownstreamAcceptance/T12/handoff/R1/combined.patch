diff --git a/test/W.EntityFrameworkCore.Dameng.FunctionalTests/DamengCurrentSchemaScriptDatabase.cs b/test/W.EntityFrameworkCore.Dameng.FunctionalTests/DamengCurrentSchemaScriptDatabase.cs
new file mode 100644
--- /dev/null
+++ b/test/W.EntityFrameworkCore.Dameng.FunctionalTests/DamengCurrentSchemaScriptDatabase.cs
@@ -0,0 +1,197 @@
+using System.Globalization;
+using System.Text.RegularExpressions;
+using W.Dm;
+using Xunit;
+
+namespace W.EntityFrameworkCore.Dameng.FunctionalTests;
+
+// This fixture uses an existing ordinary TEST account. It never creates users,
+// schemas, tablespaces or grants, and never calls EnsureDeleted.
+public sealed class DamengCurrentSchemaScriptDatabase : IAsyncLifetime
+{
+    internal const string TestSchema = "WDM_PROVIDER_TEST";
+    private readonly HashSet<CurrentSchemaScriptObjectNames> _owned = [];
+    private string _connectionString = "";
+
+    public string ConnectionString => _connectionString;
+
+    public async Task InitializeAsync()
+    {
+        _connectionString = DamengTestEnvironment.GetRequiredConnectionString();
+        await using var connection = await OpenAsync();
+    }
+
+    public async Task DisposeAsync()
+    {
+        // A failed test's finally may have left cleanup pending. Retry only its
+        // previously claimed, exact names; no wildcard or fixed history table.
+        var failures = new List<string>();
+        foreach (var names in _owned.ToArray())
+        {
+            try { await CleanupAsync(names); }
+            catch (Exception exception) { failures.Add(Kind(exception)); }
+        }
+        if (failures.Count != 0)
+            throw new InvalidOperationException("Current-schema pending cleanup failed after all groups were attempted: "
+                + string.Join(",", failures));
+    }
+
+    public async Task<DmConnection> OpenAsync()
+    {
+        var connection = new DmConnection(_connectionString);
+        try
+        {
+            await connection.OpenAsync();
+            var user = Convert.ToString(await ScalarAsync(connection, "SELECT USER FROM DUAL"), CultureInfo.InvariantCulture);
+            var schema = Convert.ToString(await ScalarAsync(connection,
+                "SELECT SF_GET_SCHEMA_NAME_BY_ID(CURRENT_SCHID()) FROM DUAL"), CultureInfo.InvariantCulture);
+            if (!string.Equals(user, TestSchema, StringComparison.OrdinalIgnoreCase)
+                || !string.Equals(schema, TestSchema, StringComparison.OrdinalIgnoreCase))
+                throw new InvalidOperationException("Current-schema scripts require the dedicated TEST account and schema.");
+            return connection;
+        }
+        catch (Exception exception)
+        {
+            try { await connection.DisposeAsync(); } catch { }
+            throw SafeFailure("open_or_identity", exception);
+        }
+    }
+
+    internal async Task ClaimAsync(CurrentSchemaScriptObjectNames names)
+    {
+        if (_owned.Contains(names)) throw new InvalidOperationException("Script names were already claimed.");
+        foreach (var name in AllNames(names))
+        {
+            if (!Regex.IsMatch(name, "^[A-Z][A-Z0-9_]{0,63}$", RegexOptions.CultureInvariant))
+                throw new InvalidOperationException("Script fixture generated an invalid owned identifier.");
+        }
+
+        await using var connection = await OpenAsync();
+        await AssertAbsentAsync(connection, names);
+        // Registration happens only after every exact name was proven absent.
+        // A collision can never give this fixture authority to delete that object.
+        _owned.Add(names);
+    }
+
+    internal async Task CleanupAsync(CurrentSchemaScriptObjectNames names)
+    {
+        if (!_owned.Contains(names)) return;
+        var failures = new List<string>();
+        try
+        {
+            await using var connection = await OpenAsync();
+            foreach (var table in Tables(names))
+            {
+                try
+                {
+                    if (await CountAsync(connection, "USER_TABLES", "TABLE_NAME", table) != 0)
+                        await ExecuteAsync(connection, "DROP TABLE \"" + table + "\"");
+                }
+                catch (Exception exception) { failures.Add(Kind(exception)); }
+            }
+            try
+            {
+                if (await CountAsync(connection, "USER_SEQUENCES", "SEQUENCE_NAME", names.Sequence) != 0)
+                    await ExecuteAsync(connection, "DROP SEQUENCE \"" + names.Sequence + "\"");
+            }
+            catch (Exception exception) { failures.Add(Kind(exception)); }
+        }
+        catch (Exception exception) { failures.Add(Kind(exception)); }
+
+        // Confirm server state on a fresh connection, even after a failed DROP.
+        try
+        {
+            await using var check = await OpenAsync();
+            await AssertAbsentAsync(check, names);
+            _owned.Remove(names);
+        }
+        catch (Exception exception) { failures.Add(Kind(exception)); }
+        if (failures.Count != 0)
+            throw new InvalidOperationException("Current-schema cleanup failed: " + string.Join(",", failures));
+    }
+
+    internal static IEnumerable<string> Tables(CurrentSchemaScriptObjectNames names)
+        => new[] { names.ChildTable, names.RenamedLookupTable, names.LookupTable, names.ParentTable, names.HistoryTable }
+            .Distinct(StringComparer.Ordinal);
+
+    private static IEnumerable<string> Indexes(CurrentSchemaScriptObjectNames names)
+        => new[] { names.Index, names.RenamedIndex }.Distinct(StringComparer.Ordinal);
+
+    private static IEnumerable<string> Constraints(CurrentSchemaScriptObjectNames names)
+		=> new[] { names.PrimaryKey, names.UniqueConstraint, names.CheckConstraint, names.ForeignKey,
+			"CPK_" + names.Prefix, "LPK_" + names.Prefix, "PK_" + names.HistoryTable }.Distinct(StringComparer.Ordinal);
+
+    internal static IEnumerable<string> AllNames(CurrentSchemaScriptObjectNames names)
+        => Tables(names).Concat([names.Sequence]).Concat(Indexes(names)).Concat(Constraints(names));
+
+    private static async Task AssertAbsentAsync(DmConnection connection, CurrentSchemaScriptObjectNames names)
+    {
+        foreach (var table in Tables(names))
+            Assert.Equal(0L, await CountAsync(connection, "USER_TABLES", "TABLE_NAME", table));
+        Assert.Equal(0L, await CountAsync(connection, "USER_SEQUENCES", "SEQUENCE_NAME", names.Sequence));
+        foreach (var index in Indexes(names))
+            Assert.Equal(0L, await CountAsync(connection, "USER_INDEXES", "INDEX_NAME", index));
+        foreach (var constraint in Constraints(names))
+            Assert.Equal(0L, await CountAsync(connection, "USER_CONSTRAINTS", "CONSTRAINT_NAME", constraint));
+    }
+
+    private static async Task<long> CountAsync(DmConnection connection, string catalog, string column, string name)
+        => Convert.ToInt64(await ScalarAsync(connection,
+            "SELECT COUNT(*) FROM " + catalog + " WHERE " + column + " = :owned_name", name), CultureInfo.InvariantCulture);
+
+    private static async Task<object?> ScalarAsync(DmConnection connection, string sql, string? name = null)
+    {
+        try
+        {
+            await using var command = connection.CreateCommand();
+            command.CommandText = sql;
+            if (name is not null)
+            {
+                var parameter = command.CreateParameter();
+                parameter.ParameterName = "owned_name";
+                parameter.Value = name;
+                command.Parameters.Add(parameter);
+            }
+            return await command.ExecuteScalarAsync();
+        }
+        catch (Exception exception) { throw SafeFailure("scalar", exception); }
+    }
+
+    private static async Task ExecuteAsync(DmConnection connection, string sql)
+    {
+        try
+        {
+            await using var command = connection.CreateCommand();
+            command.CommandText = sql;
+            await command.ExecuteNonQueryAsync();
+        }
+        catch (Exception exception) { throw SafeFailure("ddl_cleanup", exception); }
+    }
+
+    // The existing executor supplies SQL and Exception.ToString to its redactor.
+    // This replacement deliberately returns only a fixed, credential-free summary.
+    public static string Redact(string _) => "Current-schema script batch failed; raw SQL and exception text omitted.";
+
+    private static int? SafeNumber(Exception exception)
+        => exception is DmException dm ? dm.Number : exception.Data["DamengSafeNumber"] as int?;
+
+    private static string Kind(Exception exception)
+        => exception.GetType().FullName + (SafeNumber(exception) is { } number ? "/code=" + number : "");
+
+    internal static InvalidOperationException SafeFailure(string stage, Exception exception)
+    {
+        var frame = new System.Diagnostics.StackTrace(exception, true).GetFrame(0);
+        var method = frame?.GetMethod();
+        var failure = new InvalidOperationException("Current-schema script fixture failed at " + stage
+            + " (" + Kind(exception) + "); source=" + method?.DeclaringType?.Name + "." + method?.Name
+            + ":" + (frame?.GetFileLineNumber() ?? 0) + ".");
+        if (SafeNumber(exception) is { } number) failure.Data["DamengSafeNumber"] = number;
+        return failure;
+    }
+}
