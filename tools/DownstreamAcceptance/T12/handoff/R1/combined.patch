+    private static void AssertScriptBoundaries(string script, bool idempotent)
+    {
+        Assert.DoesNotContain("CREATE SCHEMA", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("DROP SCHEMA", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("CREATE USER", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("TABLESPACE", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("BEGIN TRANSACTION", script, StringComparison.Ordinal);
+        Assert.DoesNotContain("@", script, StringComparison.Ordinal);
+        var batches = idempotent ? DamengScriptExecutor.SplitIdempotent(script) : DamengScriptExecutor.SplitStatements(script);
+        Assert.NotEmpty(batches);
+        Assert.All(batches, batch => Assert.DoesNotContain(batch.Split('\n'), line => line.Trim() == "/"));
+        foreach (var block in batches.Where(batch => batch.StartsWith("BEGIN", StringComparison.Ordinal)))
+            Assert.EndsWith("END;", block, StringComparison.Ordinal);
+        if (idempotent) Assert.Contains(batches, batch => batch.StartsWith("BEGIN", StringComparison.Ordinal));
+    }
