+        command.CommandText = "SELECT \"NAME\", \"" + extraColumn + "\" FROM \"" + tableName + "\" WHERE \"ID\" = :id";
+        AddParameter(command, "id", id);
+        await using var reader = await command.ExecuteReaderAsync();
