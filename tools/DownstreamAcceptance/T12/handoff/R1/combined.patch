+internal sealed class CurrentSchemaScriptBootstrapContext(
+    DbContextOptions<CurrentSchemaScriptBootstrapContext> options,
+    CurrentSchemaScriptObjectNames names)
+    : DbContext(options)
+{
+    public CurrentSchemaScriptObjectNames Names { get; } = names;
+
+    protected override void OnModelCreating(ModelBuilder modelBuilder)
+    {
+        modelBuilder.HasSequence<long>(Names.Sequence)
+            .StartsAt(41)
+            .IncrementsBy(3)
+            .HasMin(41)
+            .HasMax(1000);
+
+        modelBuilder.Entity<CurrentSchemaScriptParent>(entity =>
+        {
+            entity.ToTable(Names.ParentTable);
+            entity.HasKey(item => item.Id).HasName(Names.PrimaryKey);
+            entity.HasAlternateKey(item => item.Name).HasName(Names.UniqueConstraint);
+            entity.Property(item => item.Id)
+                .HasColumnName("ID")
+                .HasColumnType("BIGINT")
+                .UseDamengIdentityColumn(seed: 10, increment: 2);
+            entity.Property(item => item.Name)
+                .HasColumnName("NAME")
+                .HasMaxLength(64)
+                .IsRequired();
+            entity.Property(item => item.Note)
+                .HasColumnName("NOTE")
+                .HasMaxLength(100);
