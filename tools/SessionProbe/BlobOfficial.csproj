<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreSources>$(MSBuildThisFileDirectory)../../packages</RestoreSources>
    <OutputPath>bin/BlobOfficial/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="BlobRepro.cs" />
    <PackageReference Include="DM.DmProvider" Version="8.3.1.47463" />
  </ItemGroup>
</Project>
