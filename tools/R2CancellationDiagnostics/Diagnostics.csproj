<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><NuGetAudit>false</NuGetAudit>
    <RestoreAdditionalProjectSources>$(DiagnosticPackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="W.DmProvider" Version="[$(DiagnosticPackageVersion)]" />
    <AssemblyMetadata Include="DiagnosticPackageVersion" Value="$(DiagnosticPackageVersion)" />
  </ItemGroup>
  <Target Name="RequireExactPackage" BeforeTargets="CollectPackageReferences;CoreCompile">
    <Error Condition="'$(DiagnosticPackageVersion)' == '' Or '$(DiagnosticPackageSource)' == ''" Text="An exact diagnostic package and local feed are required." />
  </Target>
</Project>
