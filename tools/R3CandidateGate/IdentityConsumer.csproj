<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>
    <RestoreAdditionalProjectSources>$(R3PackageSource)</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="W.DmProvider" Version="[$(R3PackageVersion)]" />
  </ItemGroup>
  <Target Name="RequireCandidate" BeforeTargets="CollectPackageReferences;CoreCompile">
    <Error Condition="'$(R3PackageVersion)' == '' or '$(R3PackageSource)' == ''" Text="An exact candidate version and frozen feed are required." />
  </Target>
</Project>
