<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>TemporalPrecisionProbe.Official</AssemblyName><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><NuGetAudit>false</NuGetAudit>
    <DefineConstants>$(DefineConstants);OFFICIAL</DefineConstants>
    <OutputPath>bin/Official/</OutputPath><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreSources>$(MSBuildThisFileDirectory)../../packages</RestoreSources>
  </PropertyGroup>
  <ItemGroup><Compile Include="Program.cs" /><PackageReference Include="DM.DmProvider" Version="[8.3.1.47463]" /></ItemGroup>
</Project>
