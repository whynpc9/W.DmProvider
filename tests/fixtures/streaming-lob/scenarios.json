    "text_patterns": {
      "utf8_pattern": "A雪🚀é",
      "utf8_repeat_count": 16,
      "utf8_expected_utf16_char_units": 96,
      "utf8_expected_encoded_bytes": 176,
      "utf8_expected_sha256_hex": "72e49faa8d5ec828dc5fcf52a24c2c28f5b92bca9a6f6778c334f6609eccd028",
      "gb18030_pattern": "达梦数据库",
      "gb18030_repeat_count": 16,
      "gb18030_expected_utf16_char_units": 80,
