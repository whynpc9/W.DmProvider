      "definition": "byte_at_index_i = (seed + stride * i) mod 256",
      "default_seed": 17,
      "default_stride": 131,
      "period_bytes": 256,
      "sha256_rule": "SHA-256 of exactly length_bytes generated in order; update incrementally using bounded chunks."
