      "gb18030_expected_sha256_hex": "d1f64f641ebf479ef1aeeac9f1cf8794281ff319dbc2716bd021bcb42aa0803e"
    },
    "chunk_sizes": {
      "synthetic_binary_chunk_bytes": 4096,
      "note": "Harness test parameter only; not a Dameng packet or protocol maximum."
    }
  },
  "evidence_boundary": {
    "synthetic_cases": "Every case is a deterministic generator/range/state input with execution_status not_run.",
