{
  "schema_version": 1,
  "fixture": "Async cancellation and virtual deadline scenarios",
  "identity_shape": [
    "session_id",
    "session_generation",
    "execution_id",
    "invocation_id"
  ],
  "virtual_time_model": {
    "clock": "monotonic_virtual_ticks",
    "fixed_sleep_allowed": false,
    "barrier_events": "Use named barriers to order transport progress and cancellation races."
  },
  "evidence_boundary": {
    "synthetic_cases": "Every case is a logical async state/barrier sequence with a desired contract and execution_status not_run.",
    "wire_data": "No encoded request/response bytes, protocol opcodes, or native cancel acknowledgements are included.",
    "async_evidence": "A not_run task completion expectation is not evidence that an implementation used true asynchronous I/O.",
    "server_state": "Cancel or timeout after send does not claim that the server stopped the operation."
  },
  "cases": [
    {
      "case_id": "asy01_async_only_transport_does_not_block_without_reply",
      "contract": "ASY-01",
      "execution_status": "not_run",
      "input": {
        "public_async_apis": [
          "OpenAsync",
          "ExecuteReaderAsync",
          "ReadAsync",
          "NextResultAsync",
          "CommitAsync",
          "RollbackAsync",
          "DisposeAsync"
        ],
        "fake_transport": {
          "sync_connect": "throw_test_exception",
          "sync_read": "throw_test_exception",
          "sync_write": "throw_test_exception",
          "async_reply_state": "held_at_barrier"
        },
        "operations": [
          {
            "action": "InvokeAsyncApi",
            "api": "ExecuteReaderAsync"
          },
          {
            "action": "ObserveTaskBeforeBarrier"
          }
        ]
      },
      "expected": {
        "task_completed_before_barrier_release": false,
        "async_call_returned_before_barrier_release": true,
        "synchronous_transport_call_count": 0,
        "async_transport_used": true
      }
    },
    {
      "case_id": "asy02_barrier_releases_pending_async_read",
      "contract": "ASY-02",
      "execution_status": "not_run",
      "input": {
        "fake_transport": {
          "sync_read": "throw_test_exception",
          "async_read_waits_for": "RELEASE_RESPONSE"
        },
        "barriers": [
          "READ_STARTED",
          "RELEASE_RESPONSE"
        ],
        "operations": [
          {
            "action": "InvokeAsyncApi",
            "api": "ReadAsync"
          },
          {
            "action": "Signal",
            "barrier": "READ_STARTED"
          },
          {
            "action": "Release",
            "barrier": "RELEASE_RESPONSE"
          }
        ]
      },
      "expected": {
        "task_pending_at_READ_STARTED": true,
        "task_completes_after_RELEASE_RESPONSE": true,
        "fixed_sleep_used": false,
        "sync_read_called": false
      }
    },
    {
      "case_id": "asy03_fetch_commit_dispose_async_paths_no_sync_fallback",
      "contract": "ASY-01",
      "execution_status": "not_run",
      "input": {
        "network_pending_paths": [
          "first_ReadAsync_fetch",
          "NextResultAsync",
          "CommitAsync",
          "RollbackAsync",
          "DisposeAsync"
        ],
        "fake_transport_sync_methods": "throw_test_exception",
        "completion_control": "one_barrier_per_path"
      },
      "expected": {
        "synchronous_network_fallback_count": 0,
        "all_pending_paths_reach_async_transport": true,
        "fixed_sleep_used": false
      }
    },
