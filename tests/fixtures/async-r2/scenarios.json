    {
      "id": "s08_async_io_forbids_sync_transport_calls",
      "contract": "ASY-01",
      "evidence_level": "offline_logical_fixture",
      "execution_status": "not_run",
      "setup": {
        "operation": "OpenAsync",
        "fake_transport": {
          "async_connect_gate": "closed",
          "sync_connect_behavior": "throw_test_failure",
          "sync_read_behavior": "throw_test_failure",
          "sync_write_behavior": "throw_test_failure"
        }
      },
      "steps": [
        {
          "action": "invoke_async_operation",
          "actor": "caller",
          "expect": {
            "call_returns_before_connect_gate_release": true,
            "task_completed": false,
            "sync_transport_calls": 0
          }
        },
        {
          "action": "observe_transport_wait",
          "actor": "fake_transport",
          "expect": {
            "async_connect_waiting": true,
            "sync_connect_called": false
          }
        },
        {
          "action": "release_gate",
          "gate": "async_connect_gate",
          "synthetic_result": "connected"
        },
        {
          "action": "await_operation",
          "actor": "caller",
          "expect": {
            "task_completed": true,
            "sync_transport_calls": 0
          }
        }
      ],
      "expected_outcomes": {
        "operation_completed": true,
        "async_transport_used": true,
        "sync_transport_used": false,
        "sync_fallback_would_fail_test": true
      }
    },
