    {
      "probe_id": "real_min_max_pool_and_waiter_accounting",
      "verification_status": "planned_not_run",
      "purpose": "Observe bounded capacity, a queued waiter, cancellation/timeout, and final permit accounting.",
      "preconditions": [
        "Use WDM_PROVIDER_TEST through scripts/with-dameng-test.sh.",
        "Use a controlled local DataSource with small MinPoolSize/MaxPoolSize values."
      ],
      "steps": [
        "Hold one lease and queue a second acquisition.",
        "Cancel or timeout the waiter using barriers.",
        "Return the first lease and acquire again.",
        "Record physical/leased/creating/resetting/waiter counts and cleanup."
      ],
      "evidence_limit": "No counts or observed timing are prefilled."
    },
